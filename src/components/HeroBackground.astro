<div class="hero-bg-container">
  <!-- Animated gradient background with subtle animation -->
  <div class="animated-gradient"></div>
  
  <!-- Overlay to add earth tone tint for text readability -->
  <div class="hero-video-overlay"></div>
</div>

<style>
  .hero-bg-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: 0;
  }

  .animated-gradient {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      -45deg,
      #d4a574,
      #9caf88,
      #8b7355,
      #d4a574
    );
    background-size: 400% 400%;
    animation: gradient-shift 15s ease infinite;
    z-index: 1;
  }

  @keyframes gradient-shift {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }

  /* Overlay to add earth tone tint and darken for text readability */
  .hero-video-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      135deg,
      rgba(212, 165, 116, 0.4) 0%,
      rgba(62, 39, 35, 0.6) 50%,
      rgba(156, 175, 136, 0.3) 100%
    );
    z-index: 2;
    pointer-events: none;
  }

  /* Ensure content stays above background */
  :global(.hero-content) {
    position: relative;
    z-index: 10;
  }
</style>
