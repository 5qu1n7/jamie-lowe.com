---

<div class="hero-bg-container">
  <img 
    class="hero-image"
    src="/hero-bg.jpg" 
    alt="Hero background"
  />
  
  <div class="hero-video-overlay"></div>
</div>

<style>
  :global(.hero) {
    background-size: cover;
    background-position: center;
  }
  
  .hero-bg-container {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: 0;
    background: linear-gradient(135deg, #d4a574 0%, #8b7355 100%);
  }

  .hero-image {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  .hero-video-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      135deg,
      rgba(212, 165, 116, 0.35) 0%,
      rgba(62, 39, 35, 0.55) 50%,
      rgba(156, 175, 136, 0.25) 100%
    );
    z-index: 2;
    pointer-events: none;
  }

  :global(.hero-content) {
    position: relative;
    z-index: 10;
  }
</style>
