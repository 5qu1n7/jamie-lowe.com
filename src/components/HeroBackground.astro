---
---

<div class="hero-bg-container">
  <video 
    class="hero-video"
    autoplay 
    muted 
    loop 
    playsinline
    preload="metadata"
  >
    <source src="/hero-bg.mp4" type="video/mp4" />
    Your browser does not support the video tag.
  </video>
  
  <div class="hero-video-overlay"></div>
</div>

{/* Client-side initialization for video playback */}
<script type="text/javascript">
  (function() {
    'use strict';
    
    function initHeroVideo() {
      const videoElement = document.querySelector('.hero-video');
      if (!videoElement) return;
      
      // Attempt to play video
      const attemptPlay = function() {
        const playPromise = videoElement.play();
        if (playPromise !== undefined) {
          playPromise
            .then(function() {
              console.log('✓ Hero video playing');
            })
            .catch(function(err) {
              console.warn('⚠ Autoplay blocked:', err.name);
            });
        }
      };
      
      // Try playing once video is ready
      if (videoElement.readyState >= 2) {
        attemptPlay();
      } else {
        videoElement.addEventListener('canplay', attemptPlay, { once: true });
      }
      
      // Fallback: play on user click
      document.addEventListener('click', attemptPlay, { once: true });
    }
    
    // Initialize when DOM is ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeroVideo);
    } else {
      initHeroVideo();
    }
  })();
</script>

<style>
  :global(.hero) {
    background-size: cover;
    background-position: center;
  }
  
  .hero-bg-container {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: 0;
    background: linear-gradient(135deg, #d4a574 0%, #8b7355 100%);
  }

  .hero-video {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  .hero-video-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      135deg,
      rgba(212, 165, 116, 0.35) 0%,
      rgba(62, 39, 35, 0.55) 50%,
      rgba(156, 175, 136, 0.25) 100%
    );
    z-index: 2;
    pointer-events: none;
  }

  :global(.hero-content) {
    position: relative;
    z-index: 10;
  }
</style>
