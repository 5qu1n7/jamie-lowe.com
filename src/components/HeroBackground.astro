---
---

<div class="hero-bg-container">
  <!-- Video background - served from local public folder -->
  <video 
    class="hero-video"
    autoplay 
    muted 
    loop 
    playsinline
    controls={false}
    preload="metadata"
  >
    <source src="/hero-bg.mp4" type="video/mp4" />
    Your browser does not support the video tag.
  </video>
  
  <!-- Overlay to darken video and apply earth tone color tint -->
  <div class="hero-video-overlay"></div>
</div>

<script>
  // Ensure video plays even if autoplay is blocked
  const video = document.querySelector('.hero-video');
  if (video) {
    video.muted = true;
    const playPromise = video.play();
    if (playPromise !== undefined) {
      playPromise.catch((error) => {
        console.log('Video autoplay failed, using fallback background');
      });
    }
  }
</script>

<style>
  .hero-bg-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: 0;
    background: linear-gradient(135deg, #d4a574 0%, #8b7355 100%);
  }

  .hero-video {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: translate(-50%, -50%);
    z-index: 1;
    display: block;
  }

  /* Overlay to add earth tone tint and darken for text readability */
  .hero-video-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      135deg,
      rgba(212, 165, 116, 0.35) 0%,
      rgba(62, 39, 35, 0.55) 50%,
      rgba(156, 175, 136, 0.25) 100%
    );
    z-index: 2;
    pointer-events: none;
  }

  /* Ensure content stays above video */
  :global(.hero-content) {
    position: relative;
    z-index: 10;
  }

  @media (max-width: 1024px) {
    .hero-video {
      width: 120%;
      height: 120%;
    }
  }
</style>
