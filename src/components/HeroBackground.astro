---
---

<div class="hero-bg-container">
  <!-- Video background -->
  <video 
    class="hero-video"
    autoplay 
    muted 
    loop 
    playsinline
    preload="metadata"
  >
    <!-- Texas Hill Country scenic drive -->
    <source src="https://videos.pexels.com/video-files/5755915/5755915-hd_1920_1080_30fps.mp4" type="video/mp4" />
    
    <!-- Fallback: Another scenic landscape -->
    <source src="https://videos.pexels.com/video-files/5513832/5513832-hd_1920_1080_30fps.mp4" type="video/mp4" />
    
    <!-- Fallback: Rolling hills/landscape -->
    <source src="https://videos.pexels.com/video-files/5408175/5408175-hd_1920_1080_30fps.mp4" type="video/mp4" />
    
    Your browser does not support the video tag.
  </video>
  
  <!-- Overlay to darken video and apply earth tone color tint -->
  <div class="hero-video-overlay"></div>
</div>

<style>
  .hero-bg-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: 0;
    background-color: #3e2723;
  }

  .hero-video {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: translate(-50%, -50%);
    z-index: 1;
  }

  /* Overlay to add earth tone tint and darken video for text readability */
  .hero-video-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      135deg,
      rgba(212, 165, 116, 0.3) 0%,
      rgba(62, 39, 35, 0.5) 50%,
      rgba(156, 175, 136, 0.2) 100%
    );
    z-index: 2;
    pointer-events: none;
  }

  /* Ensure content stays above video */
  :global(.hero-content) {
    position: relative;
    z-index: 10;
  }

  @media (max-width: 1024px) {
    .hero-video {
      width: 120%;
      height: 120%;
    }
  }
</style>
