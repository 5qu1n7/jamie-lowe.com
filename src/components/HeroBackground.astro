---
---

<div class="hero-bg-container">
  <video 
    class="hero-video"
    autoplay 
    muted 
    loop 
    playsinline
  >
    <source src="/hero-bg.mp4" type="video/mp4" />
  </video>
  
  <div class="hero-video-overlay"></div>
</div>

<script is:inline>
  (function() {
    function initHeroVideo() {
      const videoElement = document.querySelector('.hero-video');
      if (!videoElement) return;
      
      // Ensure video attempts to play
      const attemptPlay = () => {
        const playPromise = videoElement.play();
        if (playPromise !== undefined) {
          playPromise
            .then(() => console.log('✓ Hero video playing'))
            .catch(err => console.warn('⚠ Autoplay blocked:', err.name));
        }
      };
      
      // Try to play on load
      if (videoElement.readyState >= 2) {
        attemptPlay();
      } else {
        videoElement.addEventListener('canplay', attemptPlay, { once: true });
      }
      
      // Also try on user interaction
      document.addEventListener('click', attemptPlay, { once: true });
    }
    
    // Initialize when DOM is ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeroVideo);
    } else {
      initHeroVideo();
    }
  })();
</script>

<style>
  .hero-bg-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: 0;
    background: linear-gradient(135deg, #d4a574 0%, #8b7355 100%);
  }

  .hero-video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  .hero-video-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      135deg,
      rgba(212, 165, 116, 0.35) 0%,
      rgba(62, 39, 35, 0.55) 50%,
      rgba(156, 175, 136, 0.25) 100%
    );
    z-index: 2;
    pointer-events: none;
  }

  :global(.hero-content) {
    position: relative;
    z-index: 10;
  }
</style>
