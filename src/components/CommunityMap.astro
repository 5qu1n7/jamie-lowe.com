---
---

<div class="community-map" id="communityMap"></div>

<style>
  .community-map {
    width: 100%;
    height: 600px;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    margin: var(--spacing-2xl) 0;
  }

  @media (max-width: 768px) {
    .community-map {
      height: 400px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const map = L.map('communityMap').setView([29.4241, -98.4936], 11);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '© OpenStreetMap contributors',
      maxZoom: 19,
    }).addTo(map);

    // Mark communities
    const communities = [
      { name: 'Schertz', lat: 29.5486, lng: -98.2857 },
      { name: 'Cibolo', lat: 29.5847, lng: -98.2376 },
      { name: 'Converse', lat: 29.5036, lng: -98.3457 },
      { name: 'Live Oak', lat: 29.5281, lng: -98.1951 },
      { name: 'Bulverde', lat: 29.6489, lng: -98.4519 },
      { name: 'Spring Branch', lat: 29.8103, lng: -98.6014 },
      { name: 'Universal City', lat: 29.5689, lng: -98.3025 },
      { name: 'San Antonio', lat: 29.4241, lng: -98.4936 },
    ];

    communities.forEach(community => {
      L.circleMarker([community.lat, community.lng], {
        color: '#D4A574',
        fillColor: '#D4A574',
        fillOpacity: 0.7,
        weight: 2,
        opacity: 1,
        radius: 8
      })
        .bindPopup(`<strong>${community.name}</strong>`)
        .addTo(map);
    });
  });
</script>
