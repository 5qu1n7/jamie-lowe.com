---
import HeroBackground from './HeroBackground.astro';
import HeroSlideshow from './HeroSlideshow.astro';

interface Props {
  slideshow?: boolean;
}

const { slideshow = false } = Astro.props;
---

<section class={`hero ${slideshow ? 'hero-slideshow' : ''}`}>
  {slideshow ? <HeroSlideshow /> : <HeroBackground />}
  <div class="container hero-content">
    <slot />
  </div>
</section>

<style>
  .hero {
    padding: var(--spacing-4xl) var(--spacing-xl);
    position: relative;
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero-slideshow {
    min-height: 100vh;
    padding: 0;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    color: var(--bg-white);
    text-align: center;
    padding: var(--spacing-xl);
    margin-bottom: var(--spacing-3xl);
  }

  .hero-content :global(h1) {
    color: var(--bg-white);
    font-size: var(--font-size-5xl);
    margin-bottom: var(--spacing-lg);
    text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.7);
  }

  .hero-content :global(p) {
    color: var(--bg-light);
    font-size: var(--font-size-xl);
    max-width: 700px;
    margin: 0 auto;
    text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.6);
  }

  .hero-content :global(.btn) {
    margin-top: var(--spacing-xl);
    text-shadow: none;
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 300px;
      padding: var(--spacing-2xl) var(--spacing-lg);
    }

    .hero-content {
      padding: var(--spacing-lg);
    }

    .hero-content :global(h1) {
      font-size: var(--font-size-3xl);
    }

    .hero-content :global(p) {
      font-size: var(--font-size-base);
    }
  }
</style>
