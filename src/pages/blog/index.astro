---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import BlogCard from '../../components/BlogCard.astro';

// Import all blog posts from the current directory
const posts = await Astro.glob('./*.astro');

// Filter out index.astro and _drafts
const publishedPosts = posts.filter(post => {
  const pathname = post.file;
  return !pathname.includes('index.astro') && !pathname.includes('_drafts');
});

// Extract frontmatter and create post objects
const postsWithData = publishedPosts.map(post => {
  const filename = post.file.split('/').pop()?.replace('.astro', '') || '';
  return {
    title: post.frontmatter.title,
    description: post.frontmatter.description,
    slug: filename,
    date: post.frontmatter.pubDate,
  };
});

// Sort by date (newest first)
const sortedPosts = postsWithData.sort((a, b) => {
  return new Date(b.date).getTime() - new Date(a.date).getTime();
});
---

<BaseLayout 
  title="Blog - Jamie Lowe Real Estate"
  description="Expert insights on military relocation, home buying, VA loans, and San Antonio real estate. Tips for military families and first-time home buyers."
>
  <Hero slideshow>
    <h1>Blog</h1>
    <p>Expert insights on military relocation, home buying, and San Antonio real estate</p>
  </Hero>

  <section class="container py-3xl mt-3xl">
    <h2 style="text-align: center; margin-bottom: 2rem;">Latest Articles</h2>
    <div class="grid grid-cols-3">
      {sortedPosts.map(post => (
        <BlogCard 
          title={post.title}
          excerpt={post.description}
          slug={post.slug}
          date={post.date}
        />
      ))}
    </div>
  </section>

  <style>
    @media (max-width: 768px) {
      .grid-cols-3 {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
