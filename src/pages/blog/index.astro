---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import BlogCard from '../../components/BlogCard.astro';

const posts = [
  { slug: 'pcs-relocation.astro', title: "2026 Military Family PCS Relocation Guide to San Antonio | Jamie Lowe", description: "", date: '2026-03-21' },
  { slug: 'military-buyers-guide', title: "Military Home Buyer's Guide to San Antonio", description: "Everything military families need to know about buying a home in San Antonio, from VA loans to BAH budgeting.", date: '2025-11-15' },
  { slug: 'va-loans-explained', title: 'VA Loans in Texas: Everything Military Home Buyers Need to Know', description: "A comprehensive guide to VA loans, eligibility requirements, benefits, and how to maximize this military benefit.", date: '2025-10-22' },
  { slug: 'military-communities-north', title: 'Military-Friendly Communities in North San Antonio', description: "Discover the best neighborhoods for military families in North San Antonio with excellent schools and amenities.", date: '2025-09-08' },
  { slug: 'bah-budgeting', title: 'Understanding Your Military BAH: Home Buying Budget Planning', description: "Your Basic Allowance for Housing (BAH) is the foundation of your military home buying budget.", date: '2025-05-19' },
  { slug: 'military-communities-east', title: 'Military-Friendly Communities in East San Antonio', description: "Explore the top military-friendly neighborhoods in East San Antonio near Fort Sam Houston.", date: '2025-08-15' },
  { slug: 'new-construction-vs-existing', title: 'New Construction vs. Existing Homes: A Military Family Buyer', description: "Weighing the pros and cons of new construction vs. existing homes for military families.", date: '2025-07-10' },
  { slug: 'pcs-checklist', title: 'PCS Moving Checklist: San Antonio Edition', description: "Essential checklist for military families relocating to San Antonio.", date: '2025-06-20' },
  { slug: 'schools-military-families', title: 'Best School Districts for Military Families in San Antonio', description: "Find the best schools for military children in the San Antonio area.", date: '2025-04-12' },
].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
---

<BaseLayout 
  title="Blog - Jamie Lowe Real Estate"
  description="Expert insights on military relocation, home buying, VA loans, and San Antonio real estate."
>
  <Hero slideshow>
    <h1>Blog</h1>
    <p>Expert insights on military relocation, home buying, and San Antonio real estate</p>
  </Hero>

  <section class="container py-3xl mt-3xl">
    <h2 style="text-align: center; margin-bottom: 2rem;">Latest Articles</h2>
    <div class="grid grid-cols-3">
      {posts.map(post => (
        <BlogCard 
          title={post.title}
          excerpt={post.description}
          slug={post.slug}
          date={post.date}
        />
      ))}
    </div>
  </section>

  <style>
    @media (max-width: 768px) {
      .grid-cols-3 { grid-template-columns: 1fr; }
    }
  </style>
</BaseLayout>