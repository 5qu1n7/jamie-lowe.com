---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import BlogCard from '../../components/BlogCard.astro';

const allPosts = import.meta.glob('./*.astro', { eager: true });

const posts = Object.entries(allPosts)
  .filter(([path]) => !path.includes('index.astro'))
  .map(([path, mod]) => {
    if (mod.frontmatter && mod.frontmatter.title) {
      return {
        slug: path.replace('./', '').replace('.astro', ''),
        title: mod.frontmatter.title,
        description: mod.frontmatter.description || '',
        date: mod.frontmatter.pubDate || mod.frontmatter.publishDate || '2026-01-01',
      };
    }
    return null;
  })
  .filter(p => p !== null);
---

<!-- DEBUG START -->
<div style="background: yellow; padding: 20px; margin: 20px;">
  <h1 style="color: red;">DEBUG: Found {posts.length} posts</h1>
  <ul>
    {posts.map(p => (
      <li><strong>{p.title}</strong> - {p.date}</li>
    ))}
  </ul>
</div>
<!-- DEBUG END -->

<BaseLayout 
  title="Blog - Jamie Lowe Real Estate"
  description="Expert insights on military relocation, home buying, VA loans, and San Antonio real estate."
>
  <Hero slideshow>
    <h1>Blog</h1>
    <p>Expert insights on military relocation, home buying, and San Antonio real estate</p>
  </Hero>

  <section class="container py-3xl mt-3xl">
    <h2 style="text-align: center; margin-bottom: 2rem;">Latest Articles</h2>
    <div class="grid grid-cols-3">
      {posts.map(post => (
        <BlogCard 
          title={post.title}
          excerpt={post.description}
          slug={post.slug}
          date={post.date}
        />
      ))}
    </div>
  </section>

  <style>
    @media (max-width: 768px) {
      .grid-cols-3 { grid-template-columns: 1fr; }
    }
  </style>
</BaseLayout>