---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import BlogCard from '../../components/BlogCard.astro';
import blogPosts from '../../data/blog-posts.json';

// Posts are automatically sorted by date in the JSON file
const posts = blogPosts.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
---

<BaseLayout 
  title="Blog - Jamie Lowe Real Estate"
  description="Expert insights on military relocation, home buying, VA loans, and San Antonio real estate."
>
  <Hero slideshow>
    <h1>Blog</h1>
    <p>Expert insights on military relocation, home buying, and San Antonio real estate</p>
  </Hero>

  <section class="container py-3xl mt-3xl">
    <h2 style="text-align: center; margin-bottom: 2rem;">Latest Articles</h2>
    <div class="grid grid-cols-3">
      {posts.map(post => (
        <BlogCard 
          title={post.title}
          excerpt={post.description}
          slug={post.slug}
          date={post.date}
        />
      ))}
    </div>
  </section>

  <style>
    @media (max-width: 768px) {
      .grid-cols-3 { grid-template-columns: 1fr; }
    }
  </style>
</BaseLayout>