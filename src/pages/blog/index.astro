---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import BlogCard from '../../components/BlogCard.astro';
import fs from 'node:fs';
import path from 'node:path';

const blogDir = new URL('../../pages/blog/', import.meta.url);

// Read all .astro files in the blog directory
const files = fs.readdirSync(blogDir).filter(f => f.endsWith('.astro') && f !== 'index.astro');

const posts = files.map(f => {
  const content = fs.readFileSync(path.join(blogDir.pathname, f), 'utf-8');
  
  // Extract frontmatter
  const frontmatterMatch = content.match(/^---\n([\s\S]*?)\n---/);
  if (!frontmatterMatch) return null;
  
  const frontmatter = frontmatterMatch[1];
  const titleMatch = frontmatter.match(/title:\s*['"]([^'"]+)['"]/);
  const descMatch = frontmatter.match(/description:\s*['"]([^'"]+)['"]/);
  const dateMatch = frontmatter.match(/pubDate:\s*['"]([^'"]+)['"]/);
  const layoutMatch = frontmatter.match(/layout:\s*['"]([^'"]+)['"]/);
  
  // Skip if it uses a different layout (these posts are full pages, not cards)
  if (layoutMatch && layoutMatch[1].includes('BlogLayout')) return null;
  
  return {
    slug: f.replace('.astro', ''),
    title: titleMatch ? titleMatch[1] : f.replace('.astro', '').replace(/-/g, ' '),
    description: descMatch ? descMatch[1] : '',
    date: dateMatch ? dateMatch[1] : '2026-01-01',
  };
}).filter(p => p !== null);

// Sort by date (newest first)
const sortedPosts = posts.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
---

<BaseLayout 
  title="Blog - Jamie Lowe Real Estate"
  description="Expert insights on military relocation, home buying, VA loans, and San Antonio real estate. Tips for military families and first-time home buyers."
>
  <Hero slideshow>
    <h1>Blog</h1>
    <p>Expert insights on military relocation, home buying, and San Antonio real estate</p>
  </Hero>

  <section class="container py-3xl mt-3xl">
    <h2 style="text-align: center; margin-bottom: 2rem;">Latest Articles</h2>
    <div class="grid grid-cols-3">
      {sortedPosts.map(post => (
        <BlogCard 
          title={post.title}
          excerpt={post.description}
          slug={post.slug}
          date={post.date}
        />
      ))}
    </div>
  </section>

  <style>
    @media (max-width: 768px) {
      .grid-cols-3 {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>