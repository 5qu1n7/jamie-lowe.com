---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import BlogCard from '../../components/BlogCard.astro';

// Use Astro.glob to get all blog posts
const allPosts = import.meta.glob('./*.astro', { eager: true });

console.log('All posts keys:', Object.keys(allPosts));

const posts = Object.entries(allPosts)
  .filter(([path]) => !path.includes('index.astro'))
  .map(([path, mod]) => {
    console.log('Processing:', path, 'mod type:', typeof mod, 'has frontmatter:', !!mod.frontmatter);
    // Check if it has BlogLayout props - the file exports frontmatter from the BlogLayout component
    if (mod.frontmatter && mod.frontmatter.title) {
      return {
        slug: path.replace('./', '').replace('.astro', ''),
        title: mod.frontmatter.title,
        description: mod.frontmatter.description || '',
        date: mod.frontmatter.pubDate || mod.frontmatter.publishDate || '2026-01-01',
      };
    }
    return null;
  })
  .filter(p => p !== null);

console.log('Filtered posts:', posts.length);
---

<!-- DEBUG: Posts count = {posts.length} -->

<BaseLayout 
  title="Blog - Jamie Lowe Real Estate"
  description="Expert insights on military relocation, home buying, VA loans, and San Antonio real estate. Tips for military families and first-time home buyers."
>
  <Hero slideshow>
    <h1>Blog</h1>
    <p>Expert insights on military relocation, home buying, and San Antonio real estate</p>
  </Hero>

  <section class="container py-3xl mt-3xl">
    <h2 style="text-align: center; margin-bottom: 2rem;">Debug: Found {posts.length} posts</h2>
    <pre style="max-width: 600px; overflow: auto; background: #f5f5f5; padding: 20px; margin: 20px auto;">{JSON.stringify(posts, null, 2)}</pre>
    <h2 style="text-align: center; margin-bottom: 2rem;">Latest Articles</h2>
    <div class="grid grid-cols-3">
      {posts.map(post => (
        <BlogCard 
          title={post.title}
          excerpt={post.description}
          slug={post.slug}
          date={post.date}
        />
      ))}
    </div>
  </section>

  <style>
    @media (max-width: 768px) {
      .grid-cols-3 {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>