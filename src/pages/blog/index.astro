---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import BlogCard from '../../components/BlogCard.astro';
---

<BaseLayout title="Blog - Jamie Lowe Real Estate">
  <Hero>
    <h1>Blog</h1>
    <p>Expert insights on military relocation, home buying, and San Antonio real estate</p>
  </Hero>

  <section class="container py-3xl mt-3xl">
    <h2 style="text-align: center; margin-bottom: 2rem;">Latest Articles</h2>
    <div class="grid grid-cols-3">
      <BlogCard 
        title="Military Home Buyer's Guide to San Antonio"
        excerpt="Everything military families need to know about buying a home in San Antonio, from VA loans to BAH budgeting and community selection."
        slug="military-buyers-guide"
        date="2026-03-07"
      />
      <BlogCard 
        title="VA Loans in Texas: Everything Military Home Buyers Need to Know"
        excerpt="A comprehensive guide to VA loans, eligibility requirements, benefits, and how to maximize this incredible military benefit."
        slug="va-loans-explained"
        date="2026-03-06"
      />
      <BlogCard 
        title="Military-Friendly Communities in North San Antonio"
        excerpt="Discover the best neighborhoods for military families in North San Antonio with excellent schools and military amenities."
        slug="military-communities-north"
        date="2026-03-05"
      />
      <BlogCard 
        title="Military-Friendly Communities in East San Antonio"
        excerpt="Explore East San Antonio's military-friendly communities with established neighborhoods and great schools."
        slug="military-communities-east"
        date="2026-03-04"
      />
      <BlogCard 
        title="New Construction vs. Existing Homes: A Military Family Buyer's Comparison"
        excerpt="Understanding the pros and cons of new construction versus existing homes for military families in San Antonio."
        slug="new-construction-vs-existing"
        date="2026-03-03"
      />
      <BlogCard 
        title="Understanding Your Military BAH: Home Buying Budget Planning"
        excerpt="How to calculate your BAH, use it for home buying, and maximize your military housing benefit."
        slug="bah-budgeting"
        date="2026-03-02"
      />
      <BlogCard 
        title="PCS Moving Checklist: San Antonio Edition"
        excerpt="Complete checklist for military families relocating to San Antonio with timeline and important considerations."
        slug="pcs-checklist"
        date="2026-03-01"
      />
      <BlogCard 
        title="Best School Districts for Military Families in San Antonio"
        excerpt="Guide to top-rated school districts in San Antonio and surrounding military-friendly communities."
        slug="schools-military-families"
        date="2026-02-28"
      />
    </div>
  </section>

  <style>
    @media (max-width: 768px) {
      .grid-cols-3 {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
